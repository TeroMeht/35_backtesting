# -- Python --
__pycache__/
*.py[cod]
*.egg-info/

# -- Virtualenvs --
.venv/
venv/

# -- Tooling caches --
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# -- Editors / OS --
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# -- Local secrets --
.env
.env.*

*.csv
# -- Run outputs (regenerated by re-running the modules) --
output/

# -- Local DuckDB caches, if any land in the project dir --
*.duckdb
*.duckdb.wal

# NOTE: uv.lock is intentionally NOT ignored -- this is an
# application (package = false in pyproject.toml), so the lockfile
# is committed for reproducible installs.
